# Khemirix Smart Proxy — example configuration.
# Copy to .env and edit. Never commit real credentials or private stream URLs.

PORT=10000
HOST=0.0.0.0
VERSION=1.3.0

# Public URL of this proxy. Used to rewrite HLS playlist references.
# If blank, the URL is derived from the incoming request's Host header.
SMART_PROXY_PUBLIC_BASE_URL=https://your-smart-proxy.onrender.com

MAX_URL_LENGTH=4096

# DNS: bounded and retried; all resolved IPs are still SSRF-validated.
DNS_TIMEOUT_MS=4000
DNS_RETRIES=2
DNS_RETRY_DELAY_MS=250

# Separate network phases for slow IPTV providers.
CONNECT_TIMEOUT_MS=10000
TLS_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=20000
IDLE_TIMEOUT_MS=60000

# Bounded address failover over DNS records that were already validated.
MAX_ADDRESS_ATTEMPTS=4
CONNECTION_DEADLINE_MS=30000

# Optional IPTV compatibility. Use UPSTREAM_USER_AGENT_PROFILE=vlc for testing.
UPSTREAM_USER_AGENT=
UPSTREAM_USER_AGENT_PROFILE=default
UPSTREAM_ACCEPT=*/*
UPSTREAM_ACCEPT_LANGUAGE=
UPSTREAM_REFERER=

DETECT_MAX_BYTES=65536
MAX_PLAYLIST_BYTES=1048576
PEEK_BYTES=16384
MAX_REDIRECTS=5
MAX_CONCURRENT_STREAMS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Direct forwarding is the default. FFmpeg is intentionally not required.
PROCESSING_ENGINE=direct

LOG_LEVEL=info
