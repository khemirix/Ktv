# Khemirix Smart Proxy — example configuration.
# Copy to .env and edit. Never commit real credentials or private stream URLs.

PORT=10000
HOST=0.0.0.0
VERSION=1.0.1

# Public URL of this proxy. Used to rewrite HLS playlist references.
# If blank, the URL is derived from the incoming request's Host header.
SMART_PROXY_PUBLIC_BASE_URL=https://your-smart-proxy.onrender.com

MAX_URL_LENGTH=4096
CONNECT_TIMEOUT_MS=8000
HEADERS_TIMEOUT_MS=12000
IDLE_TIMEOUT_MS=30000
DETECT_MAX_BYTES=65536
MAX_PLAYLIST_BYTES=1048576
PEEK_BYTES=16384
MAX_REDIRECTS=5
MAX_CONCURRENT_STREAMS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Direct forwarding is the default. FFmpeg is intentionally not required.
PROCESSING_ENGINE=direct

LOG_LEVEL=info
